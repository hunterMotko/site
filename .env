# Tracked, and therefore never a place for secrets. This file documents which
# variables exist; real values belong in .env.local (gitignored) for local work,
# and in the process environment — systemd unit, Docker, or the shell — in
# production.
#
# Precedence, highest first: the real environment, then .env.local, then .env.
# Port in development (APP_ENV=development).
DP=
# Port in production. nginx terminates TLS in front, so this is the port nginx
# proxies to — binding 80 directly would require root.
PP=
# "development" enables the performance-observer script. Anything else is
# treated as production.
APP_ENV=
# Absolute origin, e.g. https://huntermotko.dev. canonical and og:url are built
# from this and omitted entirely when it is unset, because a canonical tag
# derived from a forged Host header hands ranking signal to someone else.
SITE_URL=
# SQLite file for request metrics. Unset disables metrics; the site still
# serves every page.
DB_PATH=
# Guards /stats. Unset leaves the route unregistered.
STATS_TOKEN=
# Path to the résumé PDF. The route and the download link both appear only when
# this points at a file that exists.
RESUME_PATH=
